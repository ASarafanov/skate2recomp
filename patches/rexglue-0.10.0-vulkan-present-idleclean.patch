+void VulkanCommandProcessor::MaybeSynchronizePresentIdleclean(uint32_t index, uint32_t value) {
+  // Mirrors the D3D12 present idle-clean patch: at a WAIT_UNTIL with the 3D
+  // idle-clean bit (17), between closed guest frames, wait until everything
+  // already submitted has completed. Partial frames, submissions and scratch
+  // buffer use are left alone, so this never closes or splits a submission.
+  if (index != XE_GPU_REG_WAIT_UNTIL || !(value & (UINT32_C(1) << 17)) ||
+      !present_idleclean_sync_enabled_) {
+    return;
+  }
+  auto& stats = present_idleclean_stats_;
+  ++stats.hits;
+  const uint64_t current = GetCurrentSubmission();
+  if (device_lost_ || current <= 1 || frame_open_ || submission_open_ || scratch_buffer_used_) {
+    ++stats.skipped;
+    return;
+  }
+  const uint64_t target = current - 1;
+  if (submission_completed_ < target) {
+    const auto start = std::chrono::steady_clock::now();
+    // Never pass the current submission: that would end an open submission.
+    CheckSubmissionFenceAndDeviceLoss(target);
+    stats.waited_us += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - start).count());
+    ++stats.waited;
+  }
+  if (!device_lost_ && submission_completed_ >= target) {
+    ++stats.synchronized;
+    if (stats.synchronized <= 4) {
+      REXGPU_INFO("Vulkan present idle-clean sync: value={:08X} target={} completed={}", value,
+                  target, submission_completed_);
+    }
+  }
+}
